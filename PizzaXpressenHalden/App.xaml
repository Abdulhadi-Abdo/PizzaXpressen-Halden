<Application x:Class="PizzaXpressenHalden.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PizzaXpressenHalden.ViewModels"
             xmlns:views="clr-namespace:PizzaXpressenHalden.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:OrderViewModel}">
            <views:OrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PizzaRegisterViewModel}">
            <views:PizzaRegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderLogViewModel}">
            <views:OrderLogView/>
        </DataTemplate>
    </Application.Resources>
</Application>