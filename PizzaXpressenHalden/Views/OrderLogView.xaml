<UserControl x:Class="PizzaXpressenHalden.Views.OrderLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<DockPanel>
			<TextBlock Text="Bestillingslogg" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5"/>
			<Button Content="Oppdater"
              Command="{Binding RefreshCommand}"
              Width="120"
              HorizontalAlignment="Right"
              DockPanel.Dock="Right"/>
		</DockPanel>

		<DataGrid Grid.Row="1"
              ItemsSource="{Binding Orders}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              Margin="0,12,0,0">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
				<DataGridTextColumn Header="Tid" Binding="{Binding CreatedAt}" Width="160"/>
				<DataGridTextColumn Header="Kunde" Binding="{Binding Customer}" Width="*"/>
				<DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="140"/>
				<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
				<DataGridTextColumn Header="Antall" Binding="{Binding ItemCount}" Width="90"/>
				<DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="120"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>