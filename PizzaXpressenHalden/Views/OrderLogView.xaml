<UserControl x:Class="PizzaXpressenHalden.Views.OrderLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Border BorderBrush="#2b7a2b"
                BorderThickness="2"
                CornerRadius="6"
                Padding="10"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="BESTILLINGSLOGG"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2b7a2b"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Søk etter navn, telefon eller kvitteringsnummer"/>

                    <Button Grid.Column="1"
                            Content="Oppdater"
                            Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0"
                            Width="100"
                            Height="30"/>
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding OrdersView}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          FontSize="12"
                          RowHeight="24"
                          ColumnHeaderHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kvittering nr" Binding="{Binding ReceiptNumber}" Width="110"/>
                        <DataGridTextColumn Header="Navn" Binding="{Binding CustomerName}" Width="170"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="220"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="Pris"
                                            Binding="{Binding TotalPrice, StringFormat={}{0:0.00} kr}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Opprettet"
                                            Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                            Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>