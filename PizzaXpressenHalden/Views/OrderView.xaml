<UserControl x:Class="PizzaXpressenHalden.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="InfoTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="PageDown" Command="{Binding AddOrUpdatePizzaCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="12"
          KeyboardNavigation.TabNavigation="Continue"
          KeyboardNavigation.DirectionalNavigation="Continue">
        <Border BorderBrush="#2b7a2b"
                BorderThickness="2"
                Padding="10"
                CornerRadius="6"
                Background="White">
            <Grid KeyboardNavigation.TabNavigation="Continue"
                  KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10"
                      KeyboardNavigation.TabNavigation="Continue"
                      KeyboardNavigation.DirectionalNavigation="Continue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.0*"/>
                        <ColumnDefinition Width="4.0*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BestillingPanel"
                            Grid.Column="0"
                            BorderBrush="#2b7a2b"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,10,0">
                        <Grid KeyboardNavigation.TabNavigation="Continue"
                              KeyboardNavigation.DirectionalNavigation="Continue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="BESTILLING"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#2b7a2b"
                                           Margin="0,0,0,8"/>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <TextBlock Text="Størrelse (M/L/G)" Foreground="#2b7a2b" FontSize="13"/>
                                    <TextBox x:Name="SizeBox"
                                             Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             TabIndex="0"
                                             CharacterCasing="Upper"/>

                                    <TextBlock Text="Pizza nr" Foreground="#2b7a2b" FontSize="13"/>
                                    <TextBox x:Name="PizzaNrBox"
                                             Text="{Binding PizzaNrText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             TabIndex="1"
                                             CharacterCasing="Upper"/>

                                    <TextBlock Text="Antall" Foreground="#2b7a2b" FontSize="13"/>
                                    <TextBox x:Name="AntallBox"
                                             Text="{Binding ActivePizzaQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             TabIndex="2"/>
                                </UniformGrid>

                                <TextBlock Text="{Binding ActivePizzaTitle}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,2,0,3"/>

                                <TextBlock Text="{Binding ActivePizzaPrice, StringFormat=Pris: {0:0.00} kr}"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    BorderBrush="#d9d9d9"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6"
                                    Margin="0,4,0,8"
                                    MinHeight="72">
                                <ItemsControl ItemsSource="{Binding DisplayIngredients}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#e0e0e0"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,2"
                                                    Margin="2">
                                                <TextBlock Text="{Binding}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Tips: Delt pizza: skriv f.eks. D11/14. Standardingredienser markeres med x."
                                           FontSize="11"
                                           Foreground="#555"
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Command="{Binding AddOrUpdatePizzaCommand}" Padding="10,6" Margin="0,0,10,0" TabIndex="4">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="Legg til pizza"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingPizza}" Value="True">
                                                        <Setter Property="Content" Value="Oppdater pizza"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Avbryt" Command="{Binding CancelPizzaEditCommand}" Padding="10,6" TabIndex="5">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingPizza}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsSplitPizza, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                    <TextBlock Text="Delt pizza" FontWeight="Bold" Foreground="#2b7a2b" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="1" Width="32" Margin="0,0,6,0" Command="{Binding SelectHalf1Command}"/>
                                        <Button Content="2" Width="32" Command="{Binding SelectHalf2Command}"/>
                                        <TextBlock Text="{Binding ActiveHalfLabel}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#2b7a2b"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SplitTitle}" FontSize="11" Foreground="#444" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ToppingPanel"
                            Grid.Column="1"
                            BorderBrush="#2b7a2b"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Continue">
                            <TextBlock Text="TOPPING (+ / - / x)"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2b7a2b"
                                       Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding ToppingInputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#e0e0e0" BorderThickness="1" Margin="2" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Navn}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         MaxLength="4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10"
                      KeyboardNavigation.TabNavigation="Continue"
                      KeyboardNavigation.DirectionalNavigation="Continue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="2.70*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TilbehorPanel"
                            Grid.Column="0"
                            BorderBrush="#2b7a2b"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,10,0">
                        <StackPanel KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Continue">
                            <TextBlock Text="TILBEHØR (skriv antall i boksen)"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#2b7a2b"
                                       Margin="0,0,0,6"/>

                            <Grid KeyboardNavigation.TabNavigation="Continue"
                                  KeyboardNavigation.DirectionalNavigation="Continue">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftCatalogInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#e0e0e0" BorderThickness="1" Margin="2" Padding="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Navn}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12"
                                                             Height="22"
                                                             Padding="2"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Column="2" ItemsSource="{Binding RightCatalogInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#e0e0e0" BorderThickness="1" Margin="2" Padding="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Navn}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12"
                                                             Height="22"
                                                             Padding="2"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="KundePanel"
                            Grid.Column="1"
                            BorderBrush="#2b7a2b"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,10,0">
                        <StackPanel KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Continue">
                            <TextBlock Text="KUNDE"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2b7a2b"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Telefon (auto-søk)" Foreground="#2b7a2b" FontSize="13"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FontSize="14" TabIndex="20"/>

                            <TextBlock Text="Navn" Foreground="#2b7a2b" FontSize="13" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" TabIndex="21"/>

                            <TextBlock Text="Adresse" Foreground="#2b7a2b" FontSize="13" Margin="0,8,0,0"/>
                            <TextBox x:Name="AddressBox"
                                     Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="56"
                                     FontSize="14"
                                     TabIndex="22"/>

                            <Border BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,4,0,0" Padding="4">
                                <ListBox x:Name="AddressSuggestionList"
                                         ItemsSource="{Binding AddressSuggestions}"
                                         FontSize="12"
                                         MaxHeight="90"
                                         TabIndex="23"/>
                            </Border>

                            <TextBlock Text="Klokke (HH:mm)" Foreground="#2b7a2b" FontSize="13" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     Width="90"
                                     TabIndex="24"/>

                            <TextBlock Text="Type (B/H)" Foreground="#2b7a2b" FontSize="13" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding DeliveryInputText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     Width="60"
                                     TabIndex="25"
                                     CharacterCasing="Upper"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HandlekurvPanel"
                            Grid.Column="2"
                            BorderBrush="#2b7a2b"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Continue">
                            <TextBlock Text="HANDLEKURV"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2b7a2b"
                                       Margin="0,0,0,6"/>

                            <DataGrid x:Name="HandlekurvGrid"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      Height="305"
                                      FontSize="12"
                                      RowHeight="22"
                                      ColumnHeaderHeight="24"
                                      TabIndex="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vare" Binding="{Binding ItemName}" Width="*"/>
                                    <DataGridTextColumn Header="Ant" Binding="{Binding Quantity}" Width="45"/>
                                    <DataGridTextColumn Header="Pris" Binding="{Binding UnitPrice}" Width="55"/>
                                    <DataGridTextColumn Header="Notat" Binding="{Binding Note}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="EditPizzaButton"
                                        Content="Rediger valgt pizza"
                                        Command="{Binding EditSelectedPizzaCommand}"
                                        Width="135"
                                        Height="26"
                                        Padding="8,2"
                                        Margin="0,0,10,0"
                                        FontSize="12"
                                        TabIndex="41"/>

                                <Button x:Name="RemoveItemButton"
                                        Content="Fjern valgt"
                                        Command="{Binding RemoveSelectedItemCommand}"
                                        Width="110"
                                        Height="26"
                                        Padding="8,2"
                                        FontSize="12"
                                        TabIndex="42"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#2b7a2b" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="MERKNADER" FontSize="14" FontWeight="Bold" Foreground="#2b7a2b" Margin="0,0,0,6"/>
                        <TextBox x:Name="NotesBox"
                                 Grid.Row="1"
                                 Text="{Binding OrderNotesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 Height="55"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Total, StringFormat=Totalt: {0:0.00} kr}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#2b7a2b"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            x:Name="PrintButton"
                            Content="PRINT"
                            Command="{Binding SaveAndPrintCommand}"
                            Width="230"
                            Height="54"
                            FontSize="14"
                            FontWeight="Bold"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            TabIndex="90"/>

                    <Button Grid.Column="3"
                            Content="ⓘ"
                            Command="{Binding ToggleInfoPopupCommand}"
                            Width="42"
                            Height="42"
                            FontSize="18"
                            FontWeight="Bold"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="Vis informasjon"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Visibility="{Binding IsInfoPopupOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000"
              Panel.ZIndex="100">
            <Border Width="540"
                    MaxWidth="540"
                    Padding="20"
                    Background="White"
                    BorderBrush="#2b7a2b"
                    BorderThickness="2"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Informasjon"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2b7a2b"
                               Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Standardingredienser markeres med x."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Skriv - eller -- for å fjerne en standardingrediens."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Skriv + eller ++ for å legge til ekstra topping."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Delt pizza: skriv for eksempel D11/14 og bruk knappene 1 og 2 for å redigere hver halvdel."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Tilbehør legges automatisk i handlekurven når antall skrives inn."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• PageDown legger til pizza, og PageUp redigerer pizza."/>
                    <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Trykk PRINT når bestillingen er ferdig kontrollert."/>

                    <Button Content="Lukk"
                            Command="{Binding ToggleInfoPopupCommand}"
                            Width="120"
                            Height="34"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>