<Window x:Class="PizzaXpressenHalden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PizzaXpressen Halden" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#111">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFCE3B"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#BBBBBB"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter TargetName="bg" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="DropShadow" BlurRadius="16" ShadowDepth="0" Color="#66000000" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left"
            Width="260"
            Background="{StaticResource PanelBgBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            Padding="16"
            Margin="12"
            CornerRadius="10"
            Effect="{StaticResource DropShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Ellipse Width="20" Height="20" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="PizzaXpressen" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>

                <Button Content="Bestilling"
                Command="{Binding GoOrderCommand}"
                Style="{StaticResource NavButtonStyle}"/>

                <Button Content="Pizzaregister"
                Command="{Binding GoPizzaRegisterCommand}"
                Style="{StaticResource NavButtonStyle}"/>

                <Button Content="Bestillingslogg"
                Command="{Binding GoOrderLogCommand}"
                Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
        </Border>

        <Border Margin="0,12,12,12"
            Background="#141414"
            CornerRadius="10"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </DockPanel>
</Window>
